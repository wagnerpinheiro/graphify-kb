# Information security requirements (compliance matrix rows typed as security) and security-related sections
# of the documents (title regex in en/pt/es over the original, accented text). Preset rfi-proposal.
# Extend the regex with the workspace's own security vocabulary (standards, privacy law, IAM product names).
PREFIX {{PREFIX}}: <{{NAMESPACE}}>
PREFIX kb: <http://kb.local/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT DISTINCT ?kind ?id ?title ?eligibility ?source ?location WHERE {
  {
    ?x a {{PREFIX}}:SecurityRequirement ; kb:definedIn ?doc .
    OPTIONAL { ?x kb:originalId ?oid } OPTIONAL { ?x kb:excerpt ?t } OPTIONAL { ?x {{PREFIX}}:eligibility ?eligibility }
    OPTIONAL { ?x kb:sheet ?sh } OPTIONAL { ?x kb:row ?ln } OPTIONAL { ?x kb:page ?pg }
    BIND("Requirement" AS ?kind) BIND(COALESCE(?oid, "") AS ?id)
    BIND(SUBSTR(COALESCE(?t, ""), 1, 100) AS ?title)
    BIND(IF(BOUND(?ln), CONCAT("sheet ", COALESCE(?sh, "?"), ", row ", STR(?ln)), CONCAT("p.", STR(COALESCE(?pg, "")))) AS ?location)
  } UNION {
    ?x a kb:Section ; rdfs:label ?title ; kb:definedIn ?doc .
    FILTER(REGEX(?title, "security|segurança|seguranca|seguridad|privacy|privacidade|privacidad|data protection|proteção de dados|protección de datos|GDPR|LGPD|IAM|identity|identidade|identidad|access control|controle de acesso|control de acceso|encrypt|criptograf|cifrado|vulnerab|pentest|ISO 27", "i"))
    OPTIONAL { ?x kb:number ?num } OPTIONAL { ?x kb:page ?pg2 }
    BIND("Section" AS ?kind) BIND(COALESCE(?num, "") AS ?id)
    BIND(CONCAT("p.", STR(COALESCE(?pg2, ""))) AS ?location)
  }
  ?doc dcterms:source ?source .
}
ORDER BY ?kind ?source ?id
